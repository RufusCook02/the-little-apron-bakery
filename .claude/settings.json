{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "PowerShell|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/no-push-to-main.ps1",
            "timeout": 10,
            "statusMessage": "Checking push target"
          }
        ]
      }
    ]
  }
}
